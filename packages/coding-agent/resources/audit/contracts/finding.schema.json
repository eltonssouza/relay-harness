{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/security-audit/finding.schema.json",
  "title": "Finding de auditoria (candidato ou validado)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "repository_revision", "origin_specialist", "domain", "title", "status", "severity", "priority", "confidence", "description", "exploit_conditions", "impact", "evidence", "remediation", "acceptance_criteria"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repository_revision": {"type": "string", "minLength": 1},
    "origin_specialist": {"enum": ["security", "malware", "privacy", "supply-chain", "infrastructure", "ai-security"]},
    "domain": {"type": "string", "pattern": "^(0[1-9]|1[0-9]|20)$"},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["CONFIRMADO", "POTENCIAL", "REQUER_VALIDACAO", "DESCARTADO"]},
    "suggested_status": {"enum": ["CONFIRMADO", "POTENCIAL", "REQUER_VALIDACAO", "DESCARTADO"]},
    "severity": {"enum": ["CRITICA", "ALTA", "MEDIA", "BAIXA", "INFORMATIVA"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "confidence": {"enum": ["ALTA", "MEDIA", "BAIXA"]},
    "description": {"type": "string", "minLength": 1},
    "root_cause": {"type": ["string", "null"]},
    "exploit_conditions": {"type": "string"},
    "impact": {"type": "string"},
    "compensating_controls": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "remediation": {"type": "string"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "test_recommendations": {"type": "array", "items": {"type": "string"}},
    "cwe": {"type": ["string", "null"]},
    "cve": {"type": ["string", "null"]},
    "cvss_score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "cvss_vector": {"type": ["string", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "duplicate_of": {"type": ["string", "null"]},
    "metadata": {"type": "object"},
    "validation": {"oneOf": [{"$ref": "#/$defs/validation"}, {"type": "null"}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "CONFIRMADO"}}, "required": ["status"]}, "then": {"required": ["validation"], "properties": {"validation": {"$ref": "#/$defs/validation"}}}}
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_kind", "locator", "method", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["repository_code", "repository_config", "test_artifact", "runtime_observation", "external_reference"]},
        "locator": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "file_sha256": {"type": ["string", "null"]},
        "method": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "excerpt_redacted": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "allOf": [{
        "if": {"properties": {"source_kind": {"enum": ["repository_code", "repository_config"]}}, "required": ["source_kind"]},
        "then": {"required": ["path", "line_start", "line_end"], "properties": {"path": {"type": "string", "minLength": 1}, "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}}}
      }]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_at", "independent_review", "checked_evidence_refs", "decision_reason"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "independent_review": {"const": true},
        "checked_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "decision_reason": {"type": "string", "minLength": 1},
        "validation_method": {"type": "string"},
        "remaining_uncertainties": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
