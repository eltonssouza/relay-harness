{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/security-audit/audit-run.schema.json",
  "title": "Manifesto de execução da auditoria",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "project_name", "repository_revision", "target", "authorization", "status", "profiles", "inventory_refs", "tasks", "limitations", "output_root"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "repository_revision": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "authorization": {"type": "object", "required": ["mode", "dynamic_tests_authorized", "external_network_authorized", "remote_publication_authorized"], "properties": {"mode": {"enum": ["READ_ONLY", "CONTROLLED_DYNAMIC"]}, "dynamic_tests_authorized": {"type": "boolean"}, "external_network_authorized": {"type": "boolean"}, "remote_publication_authorized": {"type": "boolean"}}},
    "status": {"enum": ["PRE_FLIGHT", "DISCOVERY", "ANALYSIS", "VALIDATION", "REPORTING", "COMPLETED", "PARTIAL", "FAILED"]},
    "profiles": {"type": "array", "items": {"type": "string"}},
    "languages": {"type": "array", "items": {"type": "string"}},
    "inventory_refs": {"type": "array", "items": {"type": "string"}},
    "threat_model_ref": {"type": ["string", "null"]},
    "tasks": {"type": "array", "items": {"type": "object", "required": ["task_id", "scope_id", "domain", "agent", "status"], "properties": {"task_id": {"type": "string"}, "scope_id": {"type": "string"}, "domain": {"type": "string", "pattern": "^(0[1-9]|1[0-9]|20)$"}, "agent": {"type": "string"}, "status": {"enum": ["PLANNED", "RUNNING", "COMPLETED", "BLOCKED", "SKIPPED"]}, "result_ref": {"type": ["string", "null"]}}}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "output_root": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "checkpoint_ref": {"type": ["string", "null"]}
  }
}
