{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Relay",
	"version": "../package.json",
	"identifier": "dev.relay-harness.desktop",
	"build": {
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Relay",
				"width": 1200,
				"height": 800,
				"minWidth": 640,
				"minHeight": 480
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"msi",
			"dmg",
			"appimage"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"resources/relay": "relay"
		},
		"category": "DeveloperTool",
		"shortDescription": "Relay, the coding agent",
		"longDescription": "A desktop window for Relay. It runs the relay binary it carries in RPC mode."
	}
}
