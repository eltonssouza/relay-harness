{
	"name": "@relay-harness/protocol",
	"version": "0.1.7",
	"description": "Transport-neutral CBOR protocol for remote relay sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"relay",
		"protocol",
		"cbor",
		"binary",
		"framing"
	],
	"author": "Elton Souza",
	"contributors": [
		"Mario Zechner",
		"Earendil Works"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eltonssouza/relay-harness.git",
		"directory": "packages/protocol"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@relay-harness/chord": "^0.1.7",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}
