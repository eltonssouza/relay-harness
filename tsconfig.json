{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@relay-harness/telemetry": ["./packages/telemetry/src/index.ts"],
			"@relay-harness/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@relay-harness/codemode": ["./packages/codemode/src/index.ts"],
			"@relay-harness/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@relay-harness/codemode/source": ["./packages/codemode/src/source.ts"],
			"@relay-harness/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@relay-harness/mcp": ["./packages/mcp/src/index.ts"],
			"@relay-harness/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@relay-harness/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@relay-harness/ai": ["./packages/ai/src/index.ts"],
			"@relay-harness/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@relay-harness/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@relay-harness/ai/dist/*": ["./packages/ai/src/*"],
			"@relay-harness/agent-core": ["./packages/agent/src/index.ts"],
			"@relay-harness/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@relay-harness/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@relay-harness/coding-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@relay-harness/tui": ["./packages/tui/src/index.ts"],
			"@relay-harness/tui/*": ["./packages/tui/src/*"],
			"@relay-harness/agent-old": ["./packages/agent-old/src/index.ts"],
			"@relay-harness/agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**"]
}
