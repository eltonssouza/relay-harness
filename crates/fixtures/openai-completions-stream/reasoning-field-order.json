{
	"name": "reasoning-field-order",
	"description": "The first non-empty reasoning field wins (chutes sends two).",
	"model": {
		"id": "test-model",
		"name": "Test Model",
		"api": "openai-completions",
		"provider": "custom",
		"baseUrl": "http://127.0.0.1:9/v1",
		"reasoning": true,
		"input": [
			"text",
			"image"
		],
		"cost": {
			"input": 0.5,
			"output": 1.5,
			"cacheRead": 0.05,
			"cacheWrite": 0.6
		},
		"contextWindow": 128000,
		"maxTokens": 32000
	},
	"messages": [
		{
			"role": "system",
			"content": "Be brief.",
			"toolsAdded": [
				{
					"name": "read",
					"description": "Read a file.",
					"parameters": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string"
							}
						},
						"required": [
							"path"
						]
					}
				},
				{
					"name": "apply_patch",
					"description": "Apply a patch.",
					"parameters": {
						"type": "object",
						"properties": {
							"patch": {
								"type": "string"
							}
						},
						"required": [
							"patch"
						]
					},
					"constrainedSampling": {
						"type": "grammar",
						"variants": {
							"openai_lark": "start: \"*** Begin Patch\" /[\\s\\S]*/"
						}
					}
				}
			],
			"timestamp": 0
		},
		{
			"role": "user",
			"content": "Go.",
			"timestamp": 0
		}
	],
	"sse": "data: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"model\":\"test-model\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\"\",\"reasoning\":\"Dup \"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"model\":\"test-model\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning\":\"text\",\"reasoning_text\":\"ignored\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"model\":\"test-model\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Ok\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"model\":\"test-model\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n",
	"splits": [],
	"events": [
		{
			"type": "start"
		},
		{
			"type": "thinking_start",
			"contentIndex": 0
		},
		{
			"type": "thinking_delta",
			"contentIndex": 0,
			"delta": "Dup "
		},
		{
			"type": "thinking_delta",
			"contentIndex": 0,
			"delta": "text"
		},
		{
			"type": "text_start",
			"contentIndex": 1
		},
		{
			"type": "text_delta",
			"contentIndex": 1,
			"delta": "Ok"
		},
		{
			"type": "thinking_end",
			"contentIndex": 0,
			"content": "Dup text"
		},
		{
			"type": "text_end",
			"contentIndex": 1,
			"content": "Ok"
		},
		{
			"type": "done",
			"reason": "stop",
			"message": {
				"role": "assistant",
				"content": [
					{
						"type": "thinking",
						"thinking": "Dup text",
						"thinkingSignature": "reasoning"
					},
					{
						"type": "text",
						"text": "Ok"
					}
				],
				"api": "openai-completions",
				"provider": "custom",
				"model": "test-model",
				"usage": {
					"input": 0,
					"output": 0,
					"cacheRead": 0,
					"cacheWrite": 0,
					"totalTokens": 0,
					"cost": {
						"input": 0,
						"output": 0,
						"cacheRead": 0,
						"cacheWrite": 0,
						"total": 0
					}
				},
				"stopReason": "stop",
				"timestamp": 0,
				"responseId": "chatcmpl-1",
				"rawStopReason": "stop"
			}
		}
	]
}
