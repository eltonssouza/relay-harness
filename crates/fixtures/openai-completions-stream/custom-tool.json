{
	"name": "custom-tool",
	"description": "A grammar tool call: custom input deltas become JSON argument deltas.",
	"model": {
		"id": "test-model",
		"name": "Test Model",
		"api": "openai-completions",
		"provider": "custom",
		"baseUrl": "http://127.0.0.1:9/v1",
		"reasoning": true,
		"input": [
			"text",
			"image"
		],
		"cost": {
			"input": 0.5,
			"output": 1.5,
			"cacheRead": 0.05,
			"cacheWrite": 0.6
		},
		"contextWindow": 128000,
		"maxTokens": 32000,
		"compat": {
			"supportsOpenAIGrammarTools": true
		}
	},
	"messages": [
		{
			"role": "system",
			"content": "Be brief.",
			"toolsAdded": [
				{
					"name": "read",
					"description": "Read a file.",
					"parameters": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string"
							}
						},
						"required": [
							"path"
						]
					}
				},
				{
					"name": "apply_patch",
					"description": "Apply a patch.",
					"parameters": {
						"type": "object",
						"properties": {
							"patch": {
								"type": "string"
							}
						},
						"required": [
							"patch"
						]
					},
					"constrainedSampling": {
						"type": "grammar",
						"variants": {
							"openai_lark": "start: \"*** Begin Patch\" /[\\s\\S]*/"
						}
					}
				}
			],
			"timestamp": 0
		},
		{
			"role": "user",
			"content": "Go.",
			"timestamp": 0
		}
	],
	"sse": "data: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"model\":\"test-model\",\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call_p\",\"type\":\"custom\",\"custom\":{\"name\":\"apply_patch\",\"input\":\"*** Begin \"}}]},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"model\":\"test-model\",\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"custom\":{\"input\":\"Patch\\n\\\"x\\\"\"}}]},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"model\":\"test-model\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"tool_calls\"}]}\n\ndata: [DONE]\n\n",
	"splits": [],
	"events": [
		{
			"type": "start"
		},
		{
			"type": "toolcall_start",
			"contentIndex": 0
		},
		{
			"type": "toolcall_delta",
			"contentIndex": 0,
			"delta": "{\"patch\":\"*** Begin "
		},
		{
			"type": "toolcall_delta",
			"contentIndex": 0,
			"delta": "Patch\\n\\\"x\\\""
		},
		{
			"type": "toolcall_delta",
			"contentIndex": 0,
			"delta": "\"}"
		},
		{
			"type": "toolcall_end",
			"contentIndex": 0,
			"toolCall": {
				"type": "toolCall",
				"id": "call_p",
				"name": "apply_patch",
				"arguments": {
					"patch": "*** Begin Patch\n\"x\""
				}
			}
		},
		{
			"type": "done",
			"reason": "toolUse",
			"message": {
				"role": "assistant",
				"content": [
					{
						"type": "toolCall",
						"id": "call_p",
						"name": "apply_patch",
						"arguments": {
							"patch": "*** Begin Patch\n\"x\""
						}
					}
				],
				"api": "openai-completions",
				"provider": "custom",
				"model": "test-model",
				"usage": {
					"input": 0,
					"output": 0,
					"cacheRead": 0,
					"cacheWrite": 0,
					"totalTokens": 0,
					"cost": {
						"input": 0,
						"output": 0,
						"cacheRead": 0,
						"cacheWrite": 0,
						"total": 0
					}
				},
				"stopReason": "toolUse",
				"timestamp": 0,
				"responseId": "chatcmpl-1",
				"rawStopReason": "tool_calls"
			}
		}
	]
}
