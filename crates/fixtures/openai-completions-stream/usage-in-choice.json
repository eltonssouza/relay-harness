{
	"name": "usage-in-choice",
	"description": "Usage inside the choice (Moonshot), with top-level cached tokens.",
	"model": {
		"id": "test-model",
		"name": "Test Model",
		"api": "openai-completions",
		"provider": "custom",
		"baseUrl": "http://127.0.0.1:9/v1",
		"reasoning": true,
		"input": [
			"text",
			"image"
		],
		"cost": {
			"input": 0.5,
			"output": 1.5,
			"cacheRead": 0.05,
			"cacheWrite": 0.6
		},
		"contextWindow": 128000,
		"maxTokens": 32000
	},
	"messages": [
		{
			"role": "system",
			"content": "Be brief.",
			"toolsAdded": [
				{
					"name": "read",
					"description": "Read a file.",
					"parameters": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string"
							}
						},
						"required": [
							"path"
						]
					}
				},
				{
					"name": "apply_patch",
					"description": "Apply a patch.",
					"parameters": {
						"type": "object",
						"properties": {
							"patch": {
								"type": "string"
							}
						},
						"required": [
							"patch"
						]
					},
					"constrainedSampling": {
						"type": "grammar",
						"variants": {
							"openai_lark": "start: \"*** Begin Patch\" /[\\s\\S]*/"
						}
					}
				}
			],
			"timestamp": 0
		},
		{
			"role": "user",
			"content": "Go.",
			"timestamp": 0
		}
	],
	"sse": "data: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"model\":\"test-model\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hi\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-1\",\"model\":\"moonshot-v1\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\",\"usage\":{\"prompt_tokens\":50,\"completion_tokens\":5,\"cached_tokens\":30}}]}\n\ndata: [DONE]\n\n",
	"splits": [],
	"events": [
		{
			"type": "start"
		},
		{
			"type": "text_start",
			"contentIndex": 0
		},
		{
			"type": "text_delta",
			"contentIndex": 0,
			"delta": "Hi"
		},
		{
			"type": "text_end",
			"contentIndex": 0,
			"content": "Hi"
		},
		{
			"type": "done",
			"reason": "stop",
			"message": {
				"role": "assistant",
				"content": [
					{
						"type": "text",
						"text": "Hi"
					}
				],
				"api": "openai-completions",
				"provider": "custom",
				"model": "test-model",
				"usage": {
					"input": 20,
					"output": 5,
					"cacheRead": 30,
					"cacheWrite": 0,
					"reasoning": 0,
					"totalTokens": 55,
					"cost": {
						"input": 0.000009999999999999999,
						"output": 0.0000075,
						"cacheRead": 0.0000015,
						"cacheWrite": 0,
						"total": 0.000018999999999999998
					}
				},
				"stopReason": "stop",
				"timestamp": 0,
				"responseId": "chatcmpl-1",
				"responseModel": "moonshot-v1",
				"rawStopReason": "stop"
			}
		}
	]
}
