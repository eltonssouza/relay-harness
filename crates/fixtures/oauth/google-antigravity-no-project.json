{
	"name": "google-antigravity-no-project",
	"provider": "google-antigravity",
	"credential": {
		"type": "oauth",
		"refresh": "refresh-1",
		"access": "access-0",
		"expires": 1699999999000
	},
	"env": {
		"RELAY_AI_ANTIGRAVITY_CLIENT_ID": "client-id",
		"RELAY_AI_ANTIGRAVITY_CLIENT_SECRET": "client-secret"
	},
	"answers": [
		{
			"match": "oauth2.googleapis.com/token",
			"status": 200,
			"body": "{\"access_token\":\"a\",\"refresh_token\":\"r\",\"expires_in\":30}",
			"headers": {
				"content-type": "application/json"
			}
		}
	],
	"requests": [
		{
			"method": "POST",
			"url": "https://oauth2.googleapis.com/token",
			"headers": {
				"content-type": "application/x-www-form-urlencoded"
			},
			"body": "client_id=client-id&client_secret=client-secret&grant_type=refresh_token&refresh_token=refresh-1"
		}
	],
	"result": {
		"type": "oauth",
		"refresh": "r",
		"access": "a",
		"expires": 1700000000000
	},
	"authError": "Missing Antigravity project. Log in again."
}
