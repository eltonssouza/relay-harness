{
	"name": "responses-headers",
	"description": "Model and request headers.",
	"adapter": "responses",
	"model": {
		"id": "test-model",
		"name": "Test",
		"api": "openai-responses",
		"provider": "openai",
		"baseUrl": "https://api.openai.com/v1",
		"reasoning": false,
		"input": [
			"text",
			"image"
		],
		"cost": {
			"input": 0,
			"output": 0,
			"cacheRead": 0,
			"cacheWrite": 0
		},
		"contextWindow": 100000,
		"maxTokens": 1000,
		"headers": {
			"x-model": "m"
		}
	},
	"options": {
		"apiKey": "sk-parity",
		"headers": {
			"x-request": "r"
		}
	},
	"messages": [
		{
			"role": "system",
			"content": "Be brief.",
			"timestamp": 0
		},
		{
			"role": "user",
			"content": "Go.",
			"timestamp": 0
		}
	],
	"request": {
		"method": "POST",
		"url": "https://api.openai.com/v1/responses",
		"headers": {
			"accept": "application/json",
			"authorization": "Bearer sk-parity",
			"content-type": "application/json",
			"user-agent": "relay (<os>)",
			"x-model": "m",
			"x-request": "r"
		},
		"omitted": [
			"x-stainless-arch",
			"x-stainless-lang",
			"x-stainless-os",
			"x-stainless-package-version",
			"x-stainless-retry-count",
			"x-stainless-runtime",
			"x-stainless-runtime-version"
		],
		"body": "{\"model\":\"test-model\",\"input\":[{\"role\":\"system\",\"content\":\"Be brief.\"},{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"Go.\"}]}],\"stream\":true,\"store\":false}"
	}
}
