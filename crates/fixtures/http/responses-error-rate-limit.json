{
	"name": "responses-error-rate-limit",
	"description": "A rate limit.",
	"adapter": "responses",
	"model": {
		"id": "test-model",
		"name": "Test",
		"api": "openai-responses",
		"provider": "openai",
		"baseUrl": "https://api.openai.com/v1",
		"reasoning": false,
		"input": [
			"text",
			"image"
		],
		"cost": {
			"input": 0,
			"output": 0,
			"cacheRead": 0,
			"cacheWrite": 0
		},
		"contextWindow": 100000,
		"maxTokens": 1000
	},
	"options": {
		"apiKey": "sk-parity"
	},
	"messages": [
		{
			"role": "system",
			"content": "Be brief.",
			"timestamp": 0
		},
		{
			"role": "user",
			"content": "Go.",
			"timestamp": 0
		}
	],
	"answer": {
		"status": 429,
		"body": "{\"error\":{\"message\":\"Rate limit reached.\",\"type\":\"requests\",\"code\":\"rate_limit_exceeded\"}}",
		"headers": {
			"content-type": "application/json"
		},
		"statusText": "Too Many Requests"
	},
	"stopReason": "error",
	"errorMessage": "OpenAI API error (429): {\"message\":\"Rate limit reached.\",\"type\":\"requests\",\"code\":\"rate_limit_exceeded\"}"
}
