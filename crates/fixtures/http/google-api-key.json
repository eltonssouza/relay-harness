{
	"name": "google-api-key",
	"description": "An API key.",
	"adapter": "google",
	"model": {
		"id": "gemini-2.5-flash",
		"name": "Test",
		"api": "google-generative-ai",
		"provider": "google",
		"baseUrl": "https://generativelanguage.googleapis.com/v1beta",
		"reasoning": false,
		"input": [
			"text",
			"image"
		],
		"cost": {
			"input": 0,
			"output": 0,
			"cacheRead": 0,
			"cacheWrite": 0
		},
		"contextWindow": 100000,
		"maxTokens": 1000
	},
	"options": {
		"apiKey": "google-parity-key"
	},
	"messages": [
		{
			"role": "system",
			"content": "Be brief.",
			"timestamp": 0
		},
		{
			"role": "user",
			"content": "Go.",
			"timestamp": 0
		}
	],
	"request": {
		"method": "POST",
		"url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:streamGenerateContent?alt=sse",
		"headers": {
			"content-type": "application/json",
			"user-agent": "relay (<os>)",
			"x-goog-api-key": "google-parity-key"
		},
		"omitted": [
			"x-goog-api-client"
		],
		"body": "{\"contents\":[{\"parts\":[{\"text\":\"Go.\"}],\"role\":\"user\"}],\"systemInstruction\":{\"parts\":[{\"text\":\"Be brief.\"}],\"role\":\"user\"},\"generationConfig\":{}}"
	}
}
